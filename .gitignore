# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Runtime data: save backups, decoded master data, extracted names.
# All derived from the user's own game files -- never committed.
data/

# Compiled Go shim, both platforms. Built locally by the launcher against a
# lunar-tear source tree so the binary always matches the server revision.
# Release archives ship it as an attached asset, not from the repository.
tools/grant/grant
tools/grant/grant.exe

# Launcher scratch space: downloaded lunar-tear source and Go toolchain.
# Hundreds of megabytes, entirely reproducible.
.build/

# Saved host, port, and the resolved lunar-tear path. Machine-specific, and
# committing it would override a fresh clone's own auto-detection.
.lunar-base.json

# Release archives produced by build-release.sh
dist/
.release-staging/

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
